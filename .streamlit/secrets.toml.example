# Streamlit Secrets Template for IoT Shield
# Streamlit Cloud: Copy & paste these into App Settings -> Secrets
# Local testing: Copy this file to .streamlit/secrets.toml (which is gitignored)

# Firebase Realtime Database URL
FIREBASE_DB_URL = "https://iot-shield-7ce30-default-rtdb.asia-southeast1.firebasedatabase.app"

# Hosted Cloud LLM API Keys (Set at least one to activate the AI Analyst)
GEMINI_API_KEY = "your-gemini-api-key"
# GROQ_API_KEY = "your-groq-api-key"
# OPENAI_API_KEY = "your-openai-api-key"
